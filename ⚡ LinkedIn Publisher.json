    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const out = $json.output ?? {};\nlet resumen = String(out.resumen_linkedin ?? '').trim();\nresumen = resumen.replace(/https?:\\/\\/\\S+/gi, '').replace(/[*_`#>]/g, '').trim();\nif (resumen.length < 200) {\n  throw new Error('El resumen generado es demasiado corto.');\n}\nconst tokens = String(out.hashtags ?? '')\n  .split(/\\s+/)\n  .map((t) => t.replace(/[.,;:]+$/, ''))\n  .filter(Boolean);\nconst hashTokens = tokens.filter((t) => t.startsWith('#'));\nconst selected = (hashTokens.length ? hashTokens : tokens).slice(0, 3);\nconst hashtags = selected.map((t) => (t.startsWith('#') ? t : `#${t}`)).join(' ');\nif (!hashtags) {\n  throw new Error('El modelo no generó hashtags.');\n}\nconst url = $(\"Extraer URL y notas\").first().json.url || '';\nconst maxResumen = Math.max(200, 3000 - url.length - hashtags.length - 20);\nif (resumen.length > maxResumen) {\n  resumen = resumen.slice(0, maxResumen).replace(/\\s+\\S*$/, '') + '…';\n}\nreturn { json: { output: { resumen_linkedin: resumen, hashtags } } };"
      },
