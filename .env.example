# Copia este archivo a .env, llena los valores y reinicia n8n.
# Los nodos leen estas variables con {{ $env.NOMBRE_VARIABLE }} (requiere
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false).
# Los tokens de Telegram, LinkedIn y NVIDIA van en credenciales nativas de n8n,
# NO en este archivo.

# ── Acceso a variables de entorno desde nodos ────────────────────────────────
# Necesario para que funcionen las expresiones {{ $env.* }} de este workflow.
# En una instancia compartida, migra esas expresiones a credenciales/valores del
# workflow y ponlo en true; este workflow, tal cual, no funciona con el bloqueo.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ── Red y dominio propio (self-hosted) ───────────────────────────────────────
# n8n debe ser accesible por HTTPS público: Telegram necesita un webhook válido.
# Si usas Caddy/Nginx/Traefik delante, apunta el proxy a 127.0.0.1:5678.
N8N_HOST=n8n.tudominio.com
N8N_PROTOCOL=https
# Incluye la barra final. Debe coincidir con la URL pública real.
WEBHOOK_URL=https://n8n.tudominio.com/
# 1 si hay un reverse proxy delante; 0 si n8n está expuesto directamente.
N8N_PROXY_HOPS=1
GENERIC_TIMEZONE=America/Caracas

# Clave estable de cifrado de credenciales. Genera una con:
#   openssl rand -hex 32
# Si ya tienes credenciales guardadas, conserva la clave actual: no la cambies
# ni la regeneres o perderás el acceso a esas credenciales.
N8N_ENCRYPTION_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ESTABLE

# ── Firecrawl ────────────────────────────────────────────────────────────────
# URL completa del endpoint /v1/scrape (cloud o self-hosted).
# Self-hosted en Docker: http://host.docker.internal:3002/v1/scrape o el nombre
# del servicio si Firecrawl está en la misma red de Docker.
FIRECRAWL_API_KEY=fc-TU_CLAVE_FIRECRAWL
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1/scrape

# ── Telegram (bot privado) ───────────────────────────────────────────────────
# Chat ID y user ID de tu cuenta. En un chat privado suelen ser el mismo número.
# Si falta cualquiera de los dos, el workflow no responde (fail-closed).
TELEGRAM_CHAT_ID=TU_CHAT_ID_TELEGRAM
TELEGRAM_USER_ID=TU_USER_ID_TELEGRAM

# ── LinkedIn ─────────────────────────────────────────────────────────────────
# Solo el ID del perfil, SIN el prefijo urn:li:person:
# Ejemplo: abc123XY (no urn:li:person:abc123XY)
LINKEDIN_PERSON_ID=TU_LINKEDIN_PERSON_ID

# ── Perfil editorial del prompt ──────────────────────────────────────────────
EDITORIAL_PERSONA=TU_HANDLE: Back-end Developer en herramientas de IA, contenido en español para audiencias en LATAM

# ── Operación de n8n (opcional) ──────────────────────────────────────────────
# Conserva los datos de ejecución 7 días y evita que el volumen crezca sin límite.
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
